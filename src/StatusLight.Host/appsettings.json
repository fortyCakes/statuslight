{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Urls": "http://127.0.0.1:5789",

  // "BlinkStick" or "Console" (logs frames instead; for working without the hardware).
  "Device": "BlinkStick",
  "BlinkStick": {
    "Serial": null
  },

  "Renderer": {
    "Brightness": 0.25,
    "FramesPerSecond": 30
  },

  "Compositor": {
    "DoneFadeAfter": "00:10:00",
    // LEDs 5-7 are reserved for future sources (e.g. Teams).
    "Zones": [
      { "Source": "claude", "Leds": [ 0, 1, 2, 3, 4 ] }
    ],
    "Styles": {
      "Idle": { "Color": "#303030", "Effect": "Solid" },
      "Working": { "Color": "#0060FF", "Effect": "Pulse", "PeriodMs": 2000 },
      "NeedsAttention": { "Color": "#FF7000", "Effect": "Blink", "PeriodMs": 800 },
      "Unread": { "Color": "#FF7000", "Effect": "Solid" },
      "Done": { "Color": "#007010", "Effect": "Solid" },
      "Error": { "Color": "#FF0000", "Effect": "Blink", "PeriodMs": 400 }
    }
  },

  "Claude": {
    "WorkingTtl": "00:30:00",
    "CloudWorkingTtl": "02:00:00",
    "AttentionTtl": "04:00:00",
    "IdleTtl": "08:00:00"
  },

  // Set CloudRelay:Topic in appsettings.Local.json to turn on polling for cloud sessions.
  "CloudRelay": {
    "BaseUrl": "https://ntfy.sh",
    "Topic": "",
    "PollInterval": "00:00:15",
    "InitialLookback": "00:10:00"
  }
}
